# Google Jules API Key (Generate at https://jules.google.com/settings)
JULES_API_KEY=your_jules_api_key_here

# Jules Subscription Tier: base (15/day), pro (100/day), ultra (300/day), or custom
JULES_TIER=base

# Optional custom daily quota limit (overrides tier default if set)
# JULES_DAILY_QUOTA_LIMIT=15

# Optional custom path for local 24h rolling quota tracker ledger
# JULES_QUOTA_FILE=/home/username/.config/opencode/jules_quota.json

# Session Settings
JULES_REQUIRE_PLAN_APPROVAL=false
JULES_AUTOMATION_MODE=AUTO_CREATE_PR
