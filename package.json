{
  "name": "opencode-jules-delegate",
  "version": "1.0.0",
  "description": "OpenCode plugin and MCP server to delegate heavy, time-consuming coding tasks to Google Jules with a 75% daily quota guardrail",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "bin": {
    "jules-oc": "./bin/cli.ts",
    "jules-mcp": "./src/mcp-server.ts",
